# ---------------------------------------------------------------
# ERP-PERN environment. On cPanel, add these in
# "Setup Node.js App" -> Environment variables (or put in server/.env)
# ---------------------------------------------------------------
NODE_ENV=production
PORT=3000

# cPanel PostgreSQL: postgres://<cpanelUser>_<dbUser>:<password>@localhost:5432/<cpanelUser>_<dbName>
# If the password has special characters (@ : / # ?) URL-encode them (e.g. @ -> %40)
DATABASE_URL=postgres://cpuser_erpuser:CHANGE_ME@localhost:5432/cpuser_erpdb
DB_POOL_MAX=5
DB_SSL=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_96_HEX_CHARS_______________________________________
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_96_HEX_CHARS_________________________________
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# Cookies: true when the site is served over HTTPS (it should be)
COOKIE_SECURE=true

# Serve the built React app from this same Node process (recommended on cPanel)
SERVE_WEB=true

# Comma separated origins allowed for CORS (leave empty when web+API share one domain)
CORS_ORIGINS=

# Open self-service tenant sign-up? Set to false after you create your own tenant
# if you only want to onboard customers manually.
ALLOW_TENANT_SIGNUP=true
